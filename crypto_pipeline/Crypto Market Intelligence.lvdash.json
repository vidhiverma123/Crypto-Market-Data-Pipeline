{
  "datasets": [
    {
      "name": "24def079",
      "displayName": "24h traded volume",
      "queryLines": [
        "SELECT\n",
        "  name                                             AS Coin,\n",
        "  market_cap_rank                                  AS Rank,\n",
        "  ROUND(total_volume / 1e9, 2)                     AS `24h Volume (B USD)`,\n",
        "  ROUND(liquidity_strength * 100, 1)               AS `Vol/MCap %`\n",
        "FROM crypto_db.gold_market_snapshot\n",
        "ORDER BY total_volume DESC;"
      ],
      "catalog": "crypto_space",
      "schema": "crypto_db"
    },
    {
      "name": "1e34612a",
      "displayName": "Market_Cap",
      "queryLines": [
        "SELECT\n",
        "  name                                             AS Coin,\n",
        "  market_cap_rank                                  AS Rank,\n",
        "  ROUND(market_cap / 1e9, 2)                       AS `Market Cap (B USD)`,\n",
        "  market_segment                                   AS Segment\n",
        "FROM crypto_db.gold_market_snapshot\n",
        "ORDER BY market_cap_rank ASC;"
      ],
      "catalog": "crypto_space",
      "schema": "crypto_db"
    },
    {
      "name": "73797c0a",
      "displayName": "Top Ranked Cryptocurrency Market Snapshot Summary",
      "queryLines": [
        "SELECT\n",
        "  name                                             AS Coin,\n",
        "  market_cap_rank                                  AS Rank,\n",
        "  ROUND(current_price, 2)                          AS `Current Price (USD)`,\n",
        "  CASE\n",
        "    WHEN price_change_percentage_24h > 0 THEN 'Up'\n",
        "    WHEN price_change_percentage_24h < 0 THEN 'Down'\n",
        "    ELSE 'Flat'\n",
        "  END                                              AS Direction\n",
        "FROM crypto_db.gold_market_snapshot\n",
        "ORDER BY market_cap_rank ASC;"
      ]
    },
    {
      "name": "4761eb44",
      "displayName": "Crypto Market Trends and Moving Averages Dataset",
      "queryLines": [
        "SELECT\n",
        "    coin_id,   -- ✅ ADD THIS\n",
        "    candle_date AS Date,\n",
        "    ROUND(open, 2)  AS Open,\n",
        "    ROUND(high, 2)  AS High,\n",
        "    ROUND(low, 2)   AS Low,\n",
        "    ROUND(close, 2) AS Close,\n",
        "    ROUND(ma_7d, 2)  AS `MA 7 Days`,\n",
        "    ROUND(ma_14d, 2) AS `MA 14 Days`,\n",
        "    ROUND(ma_30d, 2) AS `MA 30 Days`,\n",
        "    ROUND(support_14d, 2) AS `Support (14d)`,\n",
        "    ROUND(resistance_14d, 2) AS `Resistance (14d)`\n",
        "FROM crypto_db.gold_ohlc_history\n",
        "ORDER BY candle_date;"
      ],
      "columns": [
        {
          "displayName": "Direction",
          "description": "Bullish/Bearish candle direction based on Close vs Open",
          "expression": "CASE WHEN `Close` > `Open` THEN 'BULL' WHEN `Close` < `Open` THEN 'BEAR' ELSE 'DOJI' END"
        }
      ],
      "catalog": "crypto_space",
      "schema": "crypto_db"
    },
    {
      "name": "ae808998",
      "displayName": "Gold Market Daily Range and Volatility Trends Dataset",
      "queryLines": [
        "SELECT\n",
        "  coin_id AS `Coin ID`,\n",
        "  candle_date AS Date,\n",
        "  ROUND(daily_range_pct, 3) AS `Daily Range %`,\n",
        "  ROUND(volatility_7d, 4) AS `7-Day Volatility`,\n",
        "  daily_candle_direction AS Direction\n",
        "FROM\n",
        "  crypto_db.gold_ohlc_history\n",
        "ORDER BY\n",
        "  candle_date ASC"
      ],
      "catalog": "crypto_space",
      "schema": "crypto_db"
    },
    {
      "name": "c5fb6775",
      "displayName": "Gold Market Insights Data",
      "queryLines": [
        "SELECT\n",
        "  candle_date                           AS Date,\n",
        "  ROUND(daily_range_pct, 3)             AS `Daily Range %`,\n",
        "  ROUND(volatility_7d, 4)               AS `7-Day Volatility`,\n",
        "  daily_candle_direction                AS `Direction`\n",
        "FROM crypto_db.gold_ohlc_history\n",
        "ORDER BY candle_date ASC;"
      ],
      "catalog": "crypto_space",
      "schema": "crypto_db"
    },
    {
      "name": "98a37e3c",
      "displayName": "Top Gainers in Gold Market Price Changes Dataset",
      "queryLines": [
        "SELECT\n",
        "  name,\n",
        "  ROUND(price_change_percentage_24h / 100, 4) AS pct\n",
        "FROM\n",
        "  crypto_db.gold_market_snapshot\n",
        "ORDER BY\n",
        "  price_change_percentage_24h DESC\n",
        "LIMIT 1"
      ]
    },
    {
      "name": "d1199baa",
      "displayName": "gold market lowest daily price change dataset",
      "queryLines": [
        " SELECT\n",
        "  name,\n",
        "  ROUND(price_change_percentage_24h / 100, 4) AS pct\n",
        "FROM\n",
        "  crypto_db.gold_market_snapshot\n",
        "ORDER BY\n",
        "  price_change_percentage_24h ASC\n",
        "LIMIT 1"
      ],
      "catalog": "crypto_space",
      "schema": "crypto_db"
    },
    {
      "name": "f580c1f6",
      "displayName": "Crypto Trends Analysis Ratio",
      "queryLines": [
        "SELECT \n",
        "    ROUND(gainers_count * 1.0 / NULLIF(losers_count, 0), 2) AS ratio\n",
        "FROM crypto_db.gold_market_summary\n",
        "ORDER BY ingestion_date DESC\n",
        "LIMIT 1;"
      ],
      "catalog": "crypto_space",
      "schema": "crypto_db"
    },
    {
      "name": "a5742bc9",
      "displayName": "Top Five Gold Performance Metrics",
      "queryLines": [
        "SELECT\n",
        "    name,\n",
        "    price_change_percentage_24h,\n",
        "    total_volume,\n",
        "    market_cap,\n",
        "    gainer_rank\n",
        "FROM crypto_db.gold_performance_metrics\n",
        "WHERE ingestion_date = (\n",
        "    SELECT MAX(ingestion_date)\n",
        "    FROM crypto_db.gold_performance_metrics\n",
        ")\n",
        "  AND gainer_rank <= 5\n",
        "ORDER BY gainer_rank;"
      ],
      "catalog": "crypto_space",
      "schema": "crypto_db"
    },
    {
      "name": "25fb4e2d",
      "displayName": "Gold Market Decline Insights",
      "queryLines": [
        "SELECT\n",
        "    name,\n",
        "    price_change_percentage_24h,\n",
        "    total_volume,\n",
        "    market_cap,\n",
        "    loser_rank\n",
        "FROM crypto_db.gold_performance_metrics\n",
        "WHERE ingestion_date = (\n",
        "    SELECT MAX(ingestion_date)\n",
        "    FROM crypto_db.gold_performance_metrics\n",
        ")\n",
        "  AND loser_rank <= 5\n",
        "ORDER BY loser_rank;"
      ],
      "catalog": "crypto_space",
      "schema": "crypto_db"
    },
    {
      "name": "d81e3baf",
      "displayName": "Daily Snapshot of Top Trending Cryptocurrency Metrics",
      "queryLines": [
        "SELECT\n",
        "  t.trending_rank AS `Trending Rank`,\n",
        "  t.name AS Coin,\n",
        "  t.symbol AS Symbol,\n",
        "  t.market_cap_rank AS `MCap Rank`,\n",
        "  ROUND(\n",
        "    COALESCE(t.price_change_percentage_24h, m.price_change_percentage_24h),\n",
        "    2\n",
        "  ) AS `24h Change %`,\n",
        "  ROUND(COALESCE(t.current_price, m.current_price), 4) AS `Price (USD)`,\n",
        "  ROUND(COALESCE(t.market_cap, m.market_cap) / 1e9, 2) AS `MCap (B USD)`,\n",
        "  t.performance_label AS Label,\n",
        "  t.trading_signal AS Signal\n",
        "FROM\n",
        "  crypto_space.crypto_db.gold_trending_coins t\n",
        "    LEFT JOIN crypto_space.crypto_db.gold_market_snapshot m\n",
        "      ON t.coin_id = m.id\n",
        "WHERE\n",
        "  t.ingestion_date\n",
        "    = (\n",
        "      SELECT\n",
        "        MAX(ingestion_date)\n",
        "      FROM\n",
        "        crypto_space.crypto_db.gold_trending_coins\n",
        "    )\n",
        "ORDER BY\n",
        "  t.trending_rank ASC"
      ],
      "columns": [
        {
          "displayName": "Series",
          "description": "Constant value for single-color bar chart",
          "expression": "'Coin'"
        }
      ]
    }
  ],
